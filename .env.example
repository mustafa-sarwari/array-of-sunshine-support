# Placeholder values only. Never commit real credentials.
# The local demo needs none of these. They are read from the shell by the
# Amplify backend (amplify/backend.ts) and the helper scripts, so set them in
# PowerShell, e.g.  $env:BEDROCK_MODEL_ID = "amazon.nova-lite-v1:0"
# Use a named AWS CLI profile instead of access keys.

AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-2

# Backend (read at synth time by amplify/backend.ts)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
WIDGET_ALLOWED_ORIGINS=http://localhost:5173,https://www.example.com
PUBLIC_CHAT_RESERVED_CONCURRENCY=

# Smoke test (scripts/smoke.mjs)
BASE_URL=http://localhost:4173
BROWSER_CHANNEL=msedge
