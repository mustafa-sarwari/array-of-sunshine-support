# Placeholder values only. Never commit real credentials.
# The local demo needs none of these. Backend values are read from the shell
# by the Amplify backend (amplify/backend.ts) and the helper scripts, so set
# them in PowerShell, e.g.  $env:BEDROCK_MODEL_ID = "amazon.nova-lite-v1:0"
# Use a named AWS CLI profile instead of access keys.

AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-2

# Backend (read at synth time by amplify/backend.ts)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# On the AWS Free plan, Nova Lite is only available in-region in us-east-1.
BEDROCK_REGION=us-east-1
PUBLIC_CHAT_RESERVED_CONCURRENCY=

# Frontend build (read by Vite; these can go in a git-ignored .env.local)
# aws = Cognito sign-in, AppSync data, and the deployed public chat URL.
# Anything else (or unset) builds the local demo.
VITE_BACKEND=local
# Optional. Overrides custom.publicChatUrl from amplify_outputs.json.
VITE_PUBLIC_CHAT_URL=

# Smoke test (scripts/smoke.mjs)
BASE_URL=http://localhost:4173
BROWSER_CHANNEL=msedge
